        },
        {
          "type": "paragraph",
          "content": "The fee generally covers:"
        },
        {
          "type": "list",
          "items": [
            "Two-year membership validity",
            "Access to OWWA programs and services"
          ]
        },
        {
          "type": "paragraph",
          "content": "Fees may vary depending on exchange rates and payment channels."
        }
      ]
    },
