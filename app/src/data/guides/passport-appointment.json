  "content": [
    {
      "id": "what-is-a-passport-appointment",
      "title": "What is a Passport Appointment?",
      "blocks": [
        {
          "type": "paragraph",
          "content": "A **passport appointment** is a scheduled reservation required before applying for or renewing a Philippine passport through the Department of Foreign Affairs (DFA)."
        },
        {
          "type": "paragraph",
          "content": "The DFA uses an online appointment system to manage applicants efficiently and reduce overcrowding at passport processing centers."
        },
        {
          "type": "paragraph",
          "content": "A passport appointment is required for:"
        },
        {
          "type": "list",
          "items": [
            "New passport applications",
            "Passport renewals",
            "Replacement of lost passports",
            "Damaged passport applications",
            "Minor passport applications",
            "Changes or corrections in passport details"
          ]
        },
        {
          "type": "paragraph",
          "content": "Applicants must secure a confirmed appointment before visiting most DFA offices."
        }
      ]
    },
    {
      "id": "who-needs-this",
      "title": "Who Needs This?",
      "blocks": [
        {
          "type": "paragraph",
          "content": "You need a passport appointment if you are:"
        },
        {
          "type": "list",
          "items": [
            "A first-time passport applicant",
            "Renewing an expired or expiring passport",
            "Replacing a lost passport",
            "Replacing a damaged passport",
            "Applying for a passport for a minor",
            "Correcting or updating passport information"
          ]
        },
        {
          "type": "paragraph",
          "content": "Most applicants are required to schedule online before visiting a DFA processing site."
        }
      ]
    },
    {
      "id": "benefits-of-booking-a-passport-appointment",
      "title": "Benefits of Booking a Passport Appointment",
      "blocks": [
        {
          "type": "paragraph",
          "content": "Booking a passport appointment provides several advantages."
        },
        {
          "type": "subheading",
          "title": "Organized Processing",
          "content": null
        },
        {
          "type": "paragraph",
          "content": "Appointments help reduce long lines and overcrowding at DFA sites."
        },
        {
          "type": "subheading",
          "title": "Faster Transactions",
          "content": null
        },
        {
          "type": "paragraph",
          "content": "Applicants with confirmed schedules are processed more efficiently compared to walk-ins."
        },
        {
          "type": "subheading",
          "title": "Better Document Preparation",
          "content": null
        },
        {
          "type": "paragraph",
          "content": "Applicants receive guidance on required documents before their appointment date."
        },
        {
          "type": "subheading",
          "title": "Flexible Location Options",
          "content": null
        },
        {
          "type": "paragraph",
          "content": "Applicants may choose from different DFA offices and satellite sites depending on availability."
        },
        {
          "type": "subheading",
          "title": "Online Payment Convenience",
          "content": null
        },
        {
          "type": "paragraph",
          "content": "Fees can be paid using multiple payment channels without needing to queue at DFA offices."
        }
      ]
    },
    {
      "id": "appointment-methods",
